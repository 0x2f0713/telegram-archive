# Obtain these values from https://my.telegram.org. Never commit real values.
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=data/telegram_session

# Comma-separated IDs shown by `python -m app chats`. Used until the web/TUI
# saves a durable specific/all selection; choose Environment mode to restore it.
TARGET_CHATS=
# Optional YAML chat list (see config.example.yml).
CONFIG_FILE=

DATABASE_URL=sqlite:///data/archive.db
DOWNLOAD_DIR=downloads

DOWNLOAD_PHOTOS=true
DOWNLOAD_VIDEOS=true
DOWNLOAD_DOCUMENTS=true
DOWNLOAD_AUDIO=true

MAX_FILE_SIZE_MB=500
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_RETRIES=3

# Empty ALLOWED_EXTENSIONS permits every extension not explicitly ignored.
ALLOWED_EXTENSIONS=
IGNORED_EXTENSIONS=.exe

# Comma-separated, case-insensitive caption/text substrings. Empty archives all media.
KEYWORDS=

LOG_LEVEL=INFO
SHUTDOWN_TIMEOUT_SECONDS=30

# Local web dashboard. Non-loopback hosts require WEB_PASSWORD.
WEB_HOST=127.0.0.1
WEB_PORT=8686
# Docker Compose host port. The container continues to listen on 8686.
WEB_HOST_PORT=8686
WEB_USERNAME=archiver
WEB_PASSWORD=
WEB_REFRESH_SECONDS=15

# Host directories mounted into the container's persistent paths.
# Set ARCHIVER_UID/GID to the owner of these directories for bind mounts.
ARCHIVER_DATA_DIR=./data
ARCHIVER_DOWNLOADS_DIR=./downloads
ARCHIVER_UID=10001
ARCHIVER_GID=10001

# TUI database refresh interval.
TUI_REFRESH_SECONDS=5
