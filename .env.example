# Obtain these values from https://my.telegram.org. Never commit real values.
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=data/telegram_session

# Automatic MTProto proxy discovery is opt-in. Set this to true only when you
# want the worker to fetch and probe current entries from this provider.
TG_MTPROTO_PROXY_AUTO=false
TG_MTPROTO_PROXY_PROVIDER_URL=https://mtpro.xyz/mtproto
TG_MTPROTO_PROXY_CACHE_FILE=data/mtproto_proxy_cache.json
TG_MTPROTO_PROXY_PROBE_LIMIT=24
TG_MTPROTO_PROXY_CONNECT_TIMEOUT=10

# Optional explicit override. Copy a `tg://proxy?...` or `https://t.me/proxy?...`
# link from the provider to bypass discovery and use exactly one proxy.
TG_MTPROTO_PROXY=

# Comma-separated IDs shown by `python -m app chats`. Used until the web/TUI
# saves a durable specific/all selection; choose Environment mode to restore it.
TARGET_CHATS=
# Optional YAML chat list (see config.example.yml).
CONFIG_FILE=

DATABASE_URL=sqlite:///data/archive.db

# Archive storage mode: local (default) or terabox.
# - local keeps downloaded media in DOWNLOAD_DIR (unchanged behavior).
# - terabox uses DOWNLOAD_DIR on the hard drive only as a temporary buffer:
#   each finalized file is uploaded to the TeraBox API, verified, then the
#   local copy is removed. Archived media is read through the API and the
#   disposable local thumbnail/range caches.
# Faststart remuxes and HEVC H.264 variants are disabled automatically in
# terabox mode so only pristine originals are stored in the cloud.
STORAGE_MODE=local
DOWNLOAD_DIR=downloads

# TeraBox credentials (only needed when STORAGE_MODE=terabox). Use the ndus
# cookie from an authenticated TeraBox browser session. Never commit it.
TERABOX_NDUS=
# Remote folder that receives the mirrored archive tree.
TERABOX_REMOTE_DIR=/Telegram Archive
# Upload chunk size in bytes (protocol default 4 MiB for non-VIP accounts).
# TERABOX_CHUNK_SIZE=4194304

DOWNLOAD_PHOTOS=true
DOWNLOAD_VIDEOS=true
DOWNLOAD_DOCUMENTS=true
DOWNLOAD_AUDIO=true

MAX_FILE_SIZE_MB=500
DOWNLOAD_CONCURRENCY=2
# 0 uses Telethon's file-size-aware 128/256/512 KiB default. Explicitly set
# 512 only after benchmarking the route and account.
TELEGRAM_DOWNLOAD_PART_SIZE_KB=0
# TeraBox uploads remain sequential per file; this controls parallel files.
TERABOX_UPLOAD_CONCURRENCY=1
DOWNLOAD_RETRIES=3

# Empty ALLOWED_EXTENSIONS permits every extension not explicitly ignored.
ALLOWED_EXTENSIONS=
IGNORED_EXTENSIONS=.exe

# Comma-separated, case-insensitive caption/text substrings. Empty archives all media.
KEYWORDS=

LOG_LEVEL=INFO
SHUTDOWN_TIMEOUT_SECONDS=30

# Local web dashboard. Non-loopback hosts require a persistent session secret.
WEB_HOST=127.0.0.1
WEB_PORT=8686
# Docker Compose host port. The container continues to listen on 8686.
WEB_HOST_PORT=8686
WEB_SESSION_SECRET=
WEB_REFRESH_SECONDS=15

# Host directories mounted into the container's persistent paths.
# Set ARCHIVER_UID/GID to the owner of these directories for bind mounts.
ARCHIVER_DATA_DIR=./data
ARCHIVER_DOWNLOADS_DIR=./downloads
ARCHIVER_UID=1001
ARCHIVER_GID=1001

# Optional host-side ffmpeg used for faststart remuxing, video posters, and
# HEVC->H.264 variants. FFMPEG_LIB_DIR must contain the host's ffmpeg dynamic
# libraries; the app only loads them inside the ffmpeg child process, never
# itself. Leave blank to disable all of them. Set FFMPEG_LIB_DIR to a curated
# directory (no libc/libm/libpthread!) when the host lib dir would shadow the
# container's own runtime.
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
FFMPEG_LIB_DIR=./.ffmpeg-libs
TRANSCODE_CONCURRENCY=1

# Hardware decode mode for ffmpeg child processes: auto (default) or none.
# auto uses Rockchip MPP decode plus h264_rkmpp encode. Set none only when the
# host-built MPP userspace is incompatible with the container's glibc.
# VIDEO_HWACCEL=auto

# Offload HEVC transcodes to another machine with a working Rockchip ffmpeg
# (hardware decode + h264_rkmpp encode) and the archive mounted over NFS at
# HOST_DOWNLOAD_DIR. SSH key auth must work from inside the container, so
# SSH_DIR is bind-mounted read-only at /app/.ssh. Leave FFMPEG_REMOTE_HOST
# blank to transcode locally; a remote connectivity failure falls back to a
# local transcode automatically.
# SSH_DIR=/home/namhh/.ssh
# FFMPEG_REMOTE_HOST=namhh@192.168.1.2
# FFMPEG_REMOTE_BIN=/usr/local/bin/ffmpeg
# FFMPEG_REMOTE_IDENTITY=/app/.ssh/id_ed25519
# FFMPEG_REMOTE_KNOWN_HOSTS=/app/.ssh/known_hosts
# HOST_DOWNLOAD_DIR=/mnt/disk2/telegram-archiver/downloads

# Runtime media flags (editable from the System page):
# MEDIA_FASTSTART - remux completed videos so playback starts instantly.
# MEDIA_VARIANTS  - transcode HEVC to H.264 on first view + serve posters.
MEDIA_FASTSTART=true
MEDIA_VARIANTS=true

# TUI database refresh interval.
TUI_REFRESH_SECONDS=5
